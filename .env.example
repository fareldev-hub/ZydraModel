# Master password for the web UI and API.
# Leave empty to generate one automatically on first startup.
AUTH=

# Host port exposed by Docker Compose.
HOST_PORT=8000
PORT=8000

# Paths inside the API container.
MODEL_PATH=/app/model/zydra-loRa.gguf
MODEL_SERVER_URL=http://llama:8080
AUTH_FILE=/data/auth
API_KEYS_FILE=/data/database/api.json

# llama.cpp context and CPU thread settings.
MODEL_CONTEXT_SIZE=2048
MODEL_THREADS=4
