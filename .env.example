AUTH=zydra-server

HOST_PORT=8000
PORT=8000

# Model vision: dipakai HANYA untuk /v1/chat/vision (gambar + mmproj).
HF_MODEL_REPO=ggml-org/SmolVLM2-500M-Video-Instruct-GGUF:Q8_0
VISION_MODEL_REPO=ggml-org/SmolVLM2-500M-Video-Instruct-GGUF:Q8_0
VISION_SERVER_URL=http://127.0.0.1:8081
VISION_CONTEXT_SIZE=2048
VISION_THREADS=4

# Model chat: dipakai HANYA untuk /v1/chat/completions dan /v1/prompt (teks).
CHAT_MODEL_REPO=fareld3v-hub/zydra
CHAT_MODEL_FILE=zydra-loRa.gguf
CHAT_SERVER_URL=http://127.0.0.1:8082
CHAT_CONTEXT_SIZE=2048
CHAT_THREADS=4

# Fallback lama (dipakai bila VISION_* tidak diisi)
MODEL_CONTEXT_SIZE=2048
MODEL_THREADS=4

HF_HOME=/data/model-cache
AUTH_FILE=/data/auth
API_KEYS_FILE=/data/database/api.json
