# Master password for managing API keys. Leave empty to generate one on first start.
AUTH=farel-server

# Model directories inside the container.
MODEL_PATH=/app/model/zydra-base
MODEL_LORA_PATH=/app/model/zydra-lora

# Model runtime settings.
MODEL_CONTEXT_SIZE=8192
MODEL_THREADS=4
PORT=8000
PYTHONUNBUFFERED=1

# Persistent files inside the container.
API_KEYS_FILE=/data/database/api.json
AUTH_FILE=/data/auth
